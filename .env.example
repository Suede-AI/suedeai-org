SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_BOOK_TABLE=book_leads
SUPABASE_CONTACT_TABLE=contact_inquiries
RESEND_API_KEY=your-resend-api-key
BOOK_EMAIL_FROM=Suede <info@suedeai.ai>
# Reply-To on the reader-preview email (api/book.js); falls back to the sender.
BOOK_REPLY_TO=info@suedeai.ai
CONTACT_EMAIL_FROM=Suede <info@suedeai.ai>
CONTACT_NOTIFY_TO=info@suedeai.ai
SUPABASE_INVESTOR_TABLE=investor_leads
INVESTOR_EMAIL_FROM=Suede <info@suedeai.ai>
INVESTOR_NOTIFY_TO=info@suedeai.ai
INVESTOR_AUTORESPONDER=false
INVESTOR_DECK_URL=
INVESTOR_CALENDAR_URL=
SUPABASE_CALL_TABLE=call_requests
CALL_NOTIFY_TO=info@suedeai.ai
# Spam gate (api/_spam-gate.js): comma-separated origins a form POST may come
# from. Leave empty to use the built-in suedeai.org / suedeai.ai list.
FORM_ALLOWED_ORIGINS=
# Lead intake hub (api/_intake.js). Every form submission is also forwarded,
# signed, to Agent Studio. The secret must be 32+ bytes and match this
# source's entry in the hub's INTAKE_SOURCE_SECRETS. Generate one with
# `openssl rand -base64 48`. SUEDE_INTAKE_URL is optional.
SUEDE_INTAKE_SOURCE=suedeai-org
SUEDE_INTAKE_SECRET=
SUEDE_INTAKE_URL=https://agents.suedeai.ai/api/intake/events
