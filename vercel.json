{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guide/",
      "destination": "/book/",
      "permanent": true
    },
    {
      "source": "/ai/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/the-hidden-tax-stealing-time-money-and-control/",
      "destination": "/creator-ownership/",
      "permanent": true
    },
    {
      "source": "/how-record-labels-trap-artists-the-kreayshawn-case-study/",
      "destination": "/royalties/",
      "permanent": true
    },
    {
      "source": "/the-future-of-music-rights-technology-meets-creativity/",
      "destination": "/programmable-ip/",
      "permanent": true
    },
    {
      "source": "/beyond-points-4-ways-suede-labs-is-redefining-user-rewards/",
      "destination": "/royalties/",
      "permanent": true
    },
    {
      "source": "/bringing-ip-ai-powered-creative-tools-to-students/",
      "destination": "/creator-ownership/",
      "permanent": true
    },
    {
      "source": "/build-your-community-the-art-of-derivatives-remixes/",
      "destination": "/programmable-ip/",
      "permanent": true
    },
    {
      "source": "/the-first-fully-autonomous-agentic-music-marketplace/",
      "destination": "/agentic-commerce/",
      "permanent": true
    },
    {
      "source": "/the-truth-engine-for-digital-ip-and-its-live-now/",
      "destination": "/proof-of-creation/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments/feed/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/wp-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/voice/",
      "destination": "/voice/support/",
      "permanent": true
    },
    {
      "source": "/wp-content/(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/files/stake-your-claim-condensed-preview.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Link",
          "value": "<https://suedeai.ai/stake-your-claim-condensed-preview.pdf>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ] && exit 0 || exit 1"
}
